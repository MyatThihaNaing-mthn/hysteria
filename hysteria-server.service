[Unit]
Description=Hysteria 2 VPN Server
Documentation=https://v2.hysteria.network/
After=network.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple
User=nobody
Group=nogroup

# Working directory
WorkingDirectory=/etc/hysteria

# Start the server with config file
ExecStart=/usr/local/bin/hysteria server -c /etc/hysteria/config.yaml

# Restart policy
Restart=on-failure
RestartSec=10s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hysteria
ReadOnlyPaths=/etc/hysteria

# Capability restrictions
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Resource limits for 20-30 users
LimitNOFILE=65536
LimitNPROC=512

# Process limits
TasksMax=1024

# Memory and CPU limits (optional, adjust based on your server)
# MemoryMax=4G
# CPUQuota=200%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hysteria-server

[Install]
WantedBy=multi-user.target
